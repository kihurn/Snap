{
  "manifest_version": 3,
  "name": "Snap",
  "version": "1.1.0",
  "description": "Snap messy browser tabs, categories, groups, sessions, and windows into order.",
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Snap",
    "default_icon": {
      "16": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Open Snap popup"
    },
    "clean-up": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Clean up tabs (close New Tabs & duplicates, group, sort, collapse)"
    },
    "merge-windows": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Merge all windows into the active window"
    }
  }
}